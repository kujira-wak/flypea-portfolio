---
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "GARDEN / 000", description = "橙色の標本を、ただただ育てる小さな庭。" } =
  Astro.props;
const canonicalUrl = new URL("/garden-000/", siteConfig.url);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171713" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} | {siteConfig.name}</title>
  </head>
  <body class="garden-body">
    <a class="skip-link" href="#garden-main">ゲームへ移動</a>
    <a class="garden-index-link" href="/index/" aria-label="INDEXへ戻る">
      <span aria-hidden="true">←</span>
      INDEX
    </a>
    <slot />
  </body>
</html>

<style is:global>
  .garden-body {
    min-width: 20rem;
    min-height: 100vh;
    background: #171713;
    color: #f4f0e3;
  }

  .garden-index-link {
    position: fixed;
    z-index: 70;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid #f4f0e3;
    background: #171713;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .garden-index-link:hover {
    background: #6dde3b;
    color: #171713;
  }

  @media (max-width: 42rem) {
    .garden-index-link {
      top: 0.65rem;
      left: 0.65rem;
    }
  }
</style>
