---
import Container from "../../components/Container.astro";
import PageMasthead from "../../components/PageMasthead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const isDevelopment = import.meta.env.DEV;
const adminTokenPrompt = isDevelopment
  ? "worker/.dev.varsに設定したADMIN_TOKENを入力してください。"
  : "Workerに設定したADMIN_TOKENを入力してください。";
---

<BaseLayout
  title="Garden管理"
  description="GARDEN / 000のランキング掲載管理画面です。"
  pathname="/admin/garden/"
  robots="noindex, nofollow"
>
  <main id="main-content">
    <PageMasthead
      eyebrow="Admin / private utility"
      title="GARDEN INDEX"
      description="ランキングの状態を確認し、不適切なニックネームを非表示にします。管理トークンはこのタブのsessionStorageだけに保持します。"
      currentLabel="Garden管理"
    />
    <Container class="py-section">
      {
        isDevelopment && (
          <aside
            class="mb-8 max-w-2xl border-y border-ink bg-surface p-5"
            aria-labelledby="garden-admin-local-title"
          >
            <p class="micro-label text-signal">LOCAL SETUP</p>
            <h2 id="garden-admin-local-title" class="mt-2 font-display text-xl font-extrabold">
              ローカル管理トークンの確認方法
            </h2>
            <ol class="mt-4 grid list-decimal gap-2 pl-5 text-sm leading-7">
              <li>
                プロジェクト内の<code>worker/.dev.vars</code>を開きます。ファイルがなければ
                <code>worker/.dev.vars.example</code>をコピーして作成します。
              </li>
              <li><code>ADMIN_TOKEN=</code>に設定した値を確認し、Workerを再起動します。</li>
              <li>同じ値を下の管理トークン欄へ入力します。</li>
            </ol>
            <p class="mt-3 text-xs leading-6 text-muted">
              トークンをスクリーンショットやGitへ含めないでください。Worker起動ログの
              <code>env.ADMIN_TOKEN ("(hidden)")</code>は、値が読み込まれている印です。
            </p>
          </aside>
        )
      }

      <form class="grid max-w-xl gap-4 border-y border-ink py-6" data-admin-form>
        <label class="micro-label grid gap-2" for="garden-admin-token">
          管理トークン
          <input
            id="garden-admin-token"
            class="border border-ink bg-surface px-3 py-3 font-mono text-sm normal-case"
            type="password"
            autocomplete="current-password"
            required
            data-admin-token
          />
        </label>
        <button class="action-link w-fit" type="submit">ランキングを表示</button>
        <p class="text-sm text-muted" aria-live="polite" data-admin-status>
          {adminTokenPrompt}
        </p>
      </form>

      <section class="mt-10" aria-labelledby="garden-admin-results-title" hidden data-admin-results>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="micro-label text-signal">Server-authoritative records</p>
            <h2 id="garden-admin-results-title" class="section-title mt-2">PLAYERS</h2>
          </div>
          <button class="action-link action-link--quiet" type="button" data-admin-refresh>
            再読み込み
          </button>
        </div>
        <dl class="mt-6 grid border-y border-ink sm:grid-cols-3" data-admin-totals></dl>
        <div class="mt-8 overflow-x-auto border-y border-ink">
          <table class="w-full min-w-5xl border-collapse text-left text-sm">
            <thead class="bg-ink text-white">
              <tr>
                <th class="px-4 py-3" scope="col">Nickname</th>
                <th class="px-4 py-3" scope="col">認定全長</th>
                <th class="px-4 py-3" scope="col">設備</th>
                <th class="px-4 py-3" scope="col">Revision</th>
                <th class="px-4 py-3" scope="col">更新</th>
                <th class="px-4 py-3" scope="col">掲載状態</th>
                <th class="px-4 py-3" scope="col"><span class="sr-only">操作</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line" data-admin-rows></tbody>
          </table>
        </div>
      </section>
    </Container>
  </main>
</BaseLayout>

<script>
  interface GardenAdminPlayer {
    playerId: string;
    nickname: string;
    growthTicks: number;
    lengthMm: number;
    glovesLevel: number;
    rainBarrelLevel: number;
    revision: number;
    hidden: boolean;
    createdAt: number | string;
    updatedAt: number | string;
  }

  interface GardenAdminResponse {
    players: GardenAdminPlayer[];
    generatedAt: number | string;
  }

  const form = document.querySelector<HTMLFormElement>("[data-admin-form]");
  const tokenInput = document.querySelector<HTMLInputElement>("[data-admin-token]");
  const status = document.querySelector<HTMLElement>("[data-admin-status]");
  const results = document.querySelector<HTMLElement>("[data-admin-results]");
  const totals = document.querySelector<HTMLElement>("[data-admin-totals]");
  const rows = document.querySelector<HTMLTableSectionElement>("[data-admin-rows]");
  const refresh = document.querySelector<HTMLButtonElement>("[data-admin-refresh]");
  const storageKey = "flypea:admin-token";
  let players: GardenAdminPlayer[] = [];

  const formatInteger = new Intl.NumberFormat("ja-JP", { maximumFractionDigits: 0 });
  const formatDecimal = new Intl.NumberFormat("ja-JP", { maximumFractionDigits: 2 });

  const formatLength = (millimeters: number) => {
    if (!Number.isFinite(millimeters)) return "—";
    if (millimeters >= 1_000_000) return `${formatDecimal.format(millimeters / 1_000_000)} km`;
    if (millimeters >= 1_000) return `${formatDecimal.format(millimeters / 1_000)} m`;
    return `${formatDecimal.format(millimeters)} mm`;
  };

  const formatTime = (value: number | string) => {
    const numeric = typeof value === "number" ? value : Number(value);
    const date =
      Number.isFinite(numeric) && numeric > 0
        ? new Date(numeric < 1_000_000_000_000 ? numeric * 1000 : numeric)
        : new Date(value);
    return Number.isNaN(date.getTime()) ? "—" : date.toLocaleString("ja-JP");
  };

  const cell = (text: string, className = "px-4 py-3") => {
    const element = document.createElement("td");
    element.className = className;
    element.textContent = text;
    return element;
  };

  const renderTotals = () => {
    if (!totals) return;
    const visible = players.filter((player) => !player.hidden).length;
    const values: Array<[string, number]> = [
      ["登録", players.length],
      ["ランキング掲載", visible],
      ["非表示", players.length - visible],
    ];
    totals.replaceChildren(
      ...values.map(([label, value]) => {
        const wrapper = document.createElement("div");
        wrapper.className = "border-ink p-4 sm:border-r last:border-r-0";
        const term = document.createElement("dt");
        term.className = "micro-label text-muted";
        term.textContent = label;
        const description = document.createElement("dd");
        description.className = "mt-2 font-display text-3xl font-extrabold";
        description.textContent = formatInteger.format(value);
        wrapper.append(term, description);
        return wrapper;
      }),
    );
  };

  const renderRows = () => {
    if (!rows) return;
    if (players.length === 0) {
      const row = document.createElement("tr");
      const empty = cell("登録されたプレイヤーはいません。", "px-4 py-8 text-center text-muted");
      empty.colSpan = 7;
      row.append(empty);
      rows.replaceChildren(row);
      return;
    }

    rows.replaceChildren(
      ...players.map((player) => {
        const row = document.createElement("tr");
        if (player.hidden) row.className = "bg-micro/10 text-muted";

        const nickname = cell(player.nickname, "px-4 py-3 font-bold");
        const playerId = document.createElement("span");
        playerId.className = "mt-1 block font-mono text-[0.65rem] font-normal text-muted";
        playerId.textContent = player.playerId;
        nickname.append(playerId);

        const equipment = cell(
          `Gloves ${formatInteger.format(player.glovesLevel)} / Rain ${formatInteger.format(player.rainBarrelLevel)}`,
        );
        const visibility = cell(player.hidden ? "非表示" : "掲載中");
        const badge = document.createElement("span");
        badge.className = player.hidden
          ? "micro-label border border-ink px-2 py-1"
          : "micro-label border border-ink bg-signal px-2 py-1 text-ink";
        badge.textContent = visibility.textContent;
        visibility.replaceChildren(badge);

        const actionCell = cell("", "px-4 py-3 text-right");
        const action = document.createElement("button");
        action.className = "action-link action-link--quiet whitespace-nowrap";
        action.type = "button";
        action.dataset.playerAction = "visibility";
        action.dataset.playerId = player.playerId;
        action.dataset.nextHidden = String(!player.hidden);
        action.textContent = player.hidden ? "掲載へ戻す" : "非表示にする";
        action.setAttribute(
          "aria-label",
          `${player.nickname}を${player.hidden ? "ランキングへ戻す" : "ランキングから非表示にする"}`,
        );
        actionCell.append(action);

        row.append(
          nickname,
          cell(formatLength(player.lengthMm)),
          equipment,
          cell(formatInteger.format(player.revision)),
          cell(formatTime(player.updatedAt)),
          visibility,
          actionCell,
        );
        return row;
      }),
    );
  };

  const render = () => {
    renderTotals();
    renderRows();
  };

  const responseError = async (response: Response) => {
    if (response.status === 401) return "管理トークンが一致しません。";
    if (response.status === 429) return "操作が多すぎます。少し待ってから再試行してください。";
    const body = (await response.json().catch(() => null)) as { error?: string } | null;
    return body?.error
      ? `処理に失敗しました（${body.error}）。`
      : `処理に失敗しました（${response.status}）。`;
  };

  const loadPlayers = async () => {
    if (!tokenInput || !status || !results) return;
    const token = tokenInput.value.trim();
    if (!token) return;
    status.textContent = "ランキングを読み込んでいます。";
    refresh?.setAttribute("disabled", "");

    try {
      const response = await fetch("/api/garden/admin/players?limit=100&includeHidden=true", {
        headers: { authorization: `Bearer ${token}` },
        credentials: "same-origin",
        signal: AbortSignal.timeout(8000),
      });
      if (!response.ok) throw new Error(await responseError(response));
      const data = (await response.json()) as GardenAdminResponse;
      players = Array.isArray(data.players) ? data.players : [];
      window.sessionStorage.setItem(storageKey, token);
      render();
      results.hidden = false;
      status.textContent = `更新: ${formatTime(data.generatedAt)}`;
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : "ランキングを取得できませんでした。";
    } finally {
      refresh?.removeAttribute("disabled");
    }
  };

  if (form && tokenInput && status && results && totals && rows) {
    tokenInput.value = window.sessionStorage.getItem(storageKey) ?? "";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void loadPlayers();
    });
    refresh?.addEventListener("click", () => void loadPlayers());
    rows.addEventListener("click", async (event) => {
      const target = event.target;
      const action = target instanceof Element
        ? target.closest<HTMLButtonElement>("[data-player-action]")
        : null;
      if (!action || !tokenInput || !status) return;

      const playerId = action.dataset.playerId;
      const hidden = action.dataset.nextHidden === "true";
      const token = tokenInput.value.trim();
      if (!playerId || !token) return;

      action.disabled = true;
      status.textContent = hidden ? "ランキングから非表示にしています。" : "掲載を戻しています。";
      try {
        const response = await fetch(
          `/api/garden/admin/players/${encodeURIComponent(playerId)}`,
          {
            method: "PATCH",
            headers: {
              authorization: `Bearer ${token}`,
              "content-type": "application/json",
            },
            credentials: "same-origin",
            body: JSON.stringify({ hidden }),
            signal: AbortSignal.timeout(8000),
          },
        );
        if (!response.ok) throw new Error(await responseError(response));
        const data = (await response.json()) as { player: GardenAdminPlayer };
        players = players.map((player) =>
          player.playerId === data.player.playerId ? data.player : player,
        );
        render();
        status.textContent = `${data.player.nickname}を${hidden ? "非表示にしました" : "掲載へ戻しました"}。`;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "掲載状態を変更できませんでした。";
        action.disabled = false;
      }
    });
  }
</script>
