{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "flypea-reactions",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "flypea.tech/api/reactions/*",
      "zone_name": "flypea.tech"
    },
    {
      "pattern": "flypea.tech/api/garden/*",
      "zone_name": "flypea.tech"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GARDEN_COORDINATOR",
        "class_name": "GardenCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "garden-coordinator-v1",
      "new_sqlite_classes": ["GardenCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flypea-portfolio",
      "database_id": "337a3829-5a82-4564-8d5a-a1725ed2eb4b",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REACTION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "GARDEN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "REACTION_COOKIE_NAME": "flypea_reaction",
    "GARDEN_COOKIE_NAME": "flypea_garden",
    "SITE_ORIGIN": "https://flypea.tech"
  },
  "observability": {
    "enabled": true
  }
}
